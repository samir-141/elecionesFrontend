# ==============================================================================
# VARIABLES DE ENTORNO CLIENTE - FRONTEND
# Solo variables prefijadas con VITE_ son accesibles en el navegador.
# NUNCA colocar claves secretas de backend en el frontend.
# ==============================================================================

VITE_API_URL="http://localhost:4000/api"
VITE_WS_URL="http://localhost:4000"

# ==============================================================================
# SUPABASE (SOLO CLAVES PÚBLICAS DE CLIENTE)
# Obtén estos valores en Supabase Dashboard -> Project Settings -> API
# Copia estas variables en frontend/.env o frontend/.env.local
# ¡PROHIBIDO colocar SUPABASE_SERVICE_ROLE_KEY aquí!
# ==============================================================================
VITE_SUPABASE_URL="https://TU_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="tu_anon_public_key_de_supabase"


